+def placebo_scanpath(scanpath: torch.Tensor, key: tuple, seed: int, min_dist: float = 0.25) -> torch.Tensor:
+    """Keep fixation times/durations, move each center to a random point >= min_dist from the real one.
+
+    Deterministic per sample (seeded from the sample key), so resumed runs see the same placebo.
+    """
+    import hashlib
+    import random
+
+    h = int(hashlib.md5(repr((seed,) + tuple(key)).encode()).hexdigest()[:8], 16)
+    rng = random.Random(h)
+    out = scanpath.clone()
+    for i in range(out.shape[0]):
+        x, y = float(out[i, 0]), float(out[i, 1])
+        while True:
+            nx, ny = rng.random(), rng.random()
+            if (nx - x) ** 2 + (ny - y) ** 2 >= min_dist ** 2:
+                break
+        out[i, 0], out[i, 1] = nx, ny
+    return out
+
 SUPPORTED_MODES = ("no_gaze", "gazelens", "gazeqwen", "vjepa_coordpe_perlayer_lora")
 
 
